LANGSMITH_PROJECT="banking-concierge"
LANGSMITH_TRACING="true"

LANGSMITH_WORKSPACE_ID=""
LANGSMITH_API_KEY=""
BASE_URL="https://gateway.smith.langchain.com/openai/v1"

# Required. Used by the search_banking_docs embeddings client, which calls
# OpenAI's /embeddings endpoint directly — the LangSmith LLM Gateway does not
# allow-list /embeddings, so this key is required even when BASE_URL is set.
OPENAI_API_KEY=""

# Optional override; defaults to gpt-4o-mini for the agent
CONCIERGE_MODEL="gpt-4o-mini"

# Only needed for scripts/load_generation.py --mode remote
LANGGRAPH_DEPLOYMENT_URL=""
